{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS \u2014 the verifiable AI agent layer on 0G",
  "scripts": {
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test -vv",
    "gen:abis": "node packages/sdk/scripts/extract-abis.mjs",
    "deploy:testnet": "OG_NETWORK=galileo tsx scripts/deploy.ts && pnpm gen:abis",
    "deploy:mainnet": "OG_NETWORK=mainnet tsx scripts/deploy.ts && pnpm gen:abis",
    "gate:all": "pnpm gate:g3 && pnpm gate:g2 && pnpm gate:g1 && pnpm gate:g4",
    "gate:g1": "tsx scripts/g1-mint.ts",
    "gate:g2": "tsx scripts/g2-inference.ts",
    "gate:g3": "tsx scripts/g3-storage.ts",
    "gate:g4": "tsx scripts/g4-escrow.ts",
    "demo:level1": "tsx scripts/demo-level1.ts",
    "demo:level2": "tsx scripts/demo-level2.ts",
    "demo:mint": "tsx scripts/demo-mint.ts",
    "demo:run": "tsx scripts/demo-level2.ts",
    "demo:transfer": "tsx scripts/demo-transfer.ts",
    "demo:clone": "tsx scripts/demo-clone.ts",
    "demo:escrow": "tsx scripts/demo-escrow.ts",
    "demo:refund": "tsx scripts/demo-refund.ts",
    "demo:rep": "tsx scripts/demo-rep.ts",
    "demo:receipt": "tsx scripts/demo-receipt.ts",
    "verify:proofs": "tsx scripts/verify-proofs.ts",
    "gather:proofs": "tsx scripts/gather-proofs.ts",
    "test:sdk": "tsx --test packages/sdk/test/*.test.ts",
    "dev": "pnpm --filter @nexus/app dev",
    "start": "pnpm --filter @nexus/app start",
    "build": "pnpm --filter @nexus/app build",
    "api": "pnpm --filter @nexus/app dev",
    "ui": "node scripts/serve-ui.mjs",
    "deploy:erc8004": "tsx scripts/deploy-erc8004.ts",
    "demo:erc8004-register": "tsx scripts/demo-erc8004-register.ts",
    "demo:validate": "tsx scripts/demo-validate.ts",
    "demo:validate-external": "tsx scripts/demo-validate-external.ts",
    "demo:rep-feed": "tsx scripts/demo-rep-feed.ts",
    "demo:replay": "tsx scripts/demo-replay.ts",
    "demo:bundle": "tsx scripts/demo-bundle.ts",
    "verify:bundle": "tsx scripts/verify-bundle.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.32.1"
}