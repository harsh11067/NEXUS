{
  "name": "0g-nexus-sdk",
  "version": "0.1.0",
  "description": "Verifiable AI agents on 0G \u2014 TEE-sealed inference, 0G Storage-anchored traces, on-chain receipts, deterministic replay, offline proof bundles, and ERC-8004 Trustless Agents.",
  "keywords": [
    "0g",
    "0g-labs",
    "ai-agents",
    "erc-8004",
    "erc-7857",
    "tee",
    "verifiable-ai",
    "trustless-agents",
    "sealed-inference",
    "web3",
    "ethers",
    "proofs"
  ],
  "license": "Apache-2.0",
  "author": "Kumar Harsh",
  "homepage": "https://nexus-alpha-five-26.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh11067/NEXUS.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/harsh11067/NEXUS/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.10",
    "@0gfoundation/0g-compute-ts-sdk": "^0.8.4",
    "eciesjs": "^0.4.13",
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
