# ============================================================================
# NEXUS — environment configuration
# Copy this file to `.env` and fill in the values marked  >>> FILL ME <<<
#
#   cp .env.example .env
#
# The DEFAULTS below target the 0G Galileo TESTNET (chainId 16602), which is
# fully deployed and live. To run Wave 3 on 0G MAINNET (chainId 16661), see
# section 6 and flip the network block — never hand-copy a chainId, probe it:
#     cast chain-id --rpc-url https://evmrpc.0g.ai      # must print 16661
#
# `.env` is gitignored. NEVER commit real keys or tokens.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. WALLET  (the ONLY thing strictly required to run everything)
#
#    TESTNET: a Galileo key funded from https://faucet.0g.ai (~0.1 0G/day).
#    MAINNET: a freshly-generated key funded with real 0G (~0.05-0.1 0G for
#             deploy + demo txs). Do NOT reuse a key that has ever sat in a
#             shared .env or appeared on screen — generate a new one for funds.
#
#    This single key acts as deployer, agent owner, and (by default) the
#    trusted re-encryption signer. Override TRUSTED_SIGNER_KEY to separate them.
#    >>> FILL ME <<<  (0x-prefixed, 64 hex chars)
# ----------------------------------------------------------------------------
PRIVATE_KEY=

# Optional: a SECOND funded key to play "the buyer" in transfer demos (Level 3
# / E-02 money-shot). If empty, a random ephemeral buyer is generated.
BUYER_PRIVATE_KEY=

# Optional: dedicated key for the re-encryption oracle signer.
# If empty, PRIVATE_KEY is used as the trusted signer.
# On mainnet this MUST match NexusAgent.setSigner or transfers/clones revert
# BadSignature. If you only set the address (not the key), use TRUSTED_SIGNER_ADDRESS.
TRUSTED_SIGNER_KEY=
TRUSTED_SIGNER_ADDRESS=

# Flat creator royalty paid on clone(), in ether units (deploy scripts read this).
CLONE_ROYALTY=0.001

# ----------------------------------------------------------------------------
# 2. 0G CHAIN   (defaults = Galileo TESTNET — leave as-is for testnet)
# ----------------------------------------------------------------------------
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602
OG_EXPLORER_URL=https://chainscan-galileo.0g.ai

# ----------------------------------------------------------------------------
# 3. 0G STORAGE   (defaults = Galileo TESTNET — leave as-is for testnet)
#    Encrypted personas, trace bundles, fulfillment evidence live here.
#    Note: storage propagation takes 3-5 min; retrieval right after upload
#    can legitimately 404 — use retry/backoff, don't hard-fail.
# ----------------------------------------------------------------------------
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
OG_STORAGE_EXPLORER=https://storagescan-galileo.0g.ai
OG_FLOW_CONTRACT=0x22E03a6A89B950F1c82ec5e74F8eCa321a105296

# ----------------------------------------------------------------------------
# 4. 0G COMPUTE — Sealed Inference (TEE)
#
#    BROKER mode (default): no API key. PRIVATE_KEY funds an on-chain ledger
#    and signs each request. Compute runs on the SAME 0G chain, so one funded
#    wallet covers it. On first run the runtime opens the ledger; some nodes
#    enforce a ~3 0G minimum deposit even if the code requests less — keep the
#    operator wallet >= ~3.2 0G in broker mode, or switch to router.
#
#    ROUTER mode: set OG_COMPUTE_MODE=router and supply an sk-... API key.
#
#    Before a mainnet demo, confirm the provider is TeeML (not TeeTLS):
#      0g-compute-cli inference verify --provider <ADDR>
#    Only TeeML backs the "hardware-verified" claim.
# ----------------------------------------------------------------------------
OG_COMPUTE_MODE=broker
OG_COMPUTE_ROUTER_URL=https://router-api.0g.ai/v1
OG_COMPUTE_API_KEY=
OG_COMPUTE_MODEL=zai-org/GLM-5-FP8
# broker runs on the same 0G chain — mirror OG_RPC_URL for the active network:
OG_COMPUTE_RPC_URL=https://evmrpc-testnet.0g.ai
OG_COMPUTE_PROVIDER=
OG_COMPUTE_DEPOSIT=3

# ----------------------------------------------------------------------------
# 5. DEPLOYED CONTRACT ADDRESSES
#    Written automatically by the deploy script (contracts/deployments/
#    <network>.json, also embedded into the SDK) and read as a LAST-RESORT
#    fallback on serverless. You normally never edit these by hand.
#    Mainnet fallback vars use a _MAINNET suffix (NEXUS_AGENT_ADDRESS_MAINNET
#    etc.) so a stale testnet address can never masquerade as mainnet.
#
#    Values below are the LIVE Galileo testnet deployment.
# ----------------------------------------------------------------------------
NEXUS_AGENT_ADDRESS=0x8B1BB4B8E6c7c3484FA6DECC360B9FC63dBf2D78
PROOFMESH_ADDRESS=0x1bE84724492C94124F166904E54A3F9e289A4814
NEXUS_ESCROW_ADDRESS=0xE85c91123734FEABABF547C5f08b8E433D119BF4
REPUTATION_ADDRESS=0xaA2292341aEe457a2dE3f535006A8F47aE5a8625
COMPOSITE_MINTER_ADDRESS=0xf6e60F3130774051e12C697cc87682293A0FCDc2

# ----------------------------------------------------------------------------
# 6. 0G MAINNET (chainId 16661) — IMPLEMENTED network switch
#
#    The SDK is network-aware. Selection precedence:
#      OG_NETWORK=galileo|mainnet  >  NEXT_PUBLIC_USE_MAINNET=true  >
#      OG_CHAIN_ID=16661  >  default galileo
#
#    You do NOT need to rewrite sections 2/3: when mainnet is selected, the
#    correct RPC / explorer / storage-indexer presets apply automatically, and
#    stale testnet values above are ignored (only a deliberately custom URL
#    overrides a preset). Deployed addresses come from
#    contracts/deployments/<network>.json (embedded into the SDK at deploy
#    time, so Vercel needs no address env vars).
#
#    OG_MAINNET_KEY: a dedicated funded mainnet key. On mainnet it takes
#    precedence over PRIVATE_KEY, so a testnet key never signs against real
#    funds. Generate it fresh; fund with ~0.1 0G (+3 0G if broker-mode
#    Sealed Inference — the ledger deposit is retrievable).
#
#    Always verify the chain id live before relying on it:
#      cast chain-id --rpc-url https://evmrpc.0g.ai      # must print 16661
#
# OG_NETWORK=mainnet
# NEXT_PUBLIC_USE_MAINNET=true
OG_MAINNET_KEY=
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 7. DEPLOY / HOSTING TOKENS  (optional — only for CI, Vercel, Render pushes)
#    Keep these OUT of the browser bundle; server-only. Rotate any token that
#    has been shared or shown on screen.
# ----------------------------------------------------------------------------
VERCEL_TOKEN=
RENDER_API_KEY=
GITHUB_TOKEN=
