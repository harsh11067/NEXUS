# ============================================================================
# NEXUS — environment configuration
# Copy this file to `.env` and fill in the values marked  >>> FILL ME <<<
# Everything else already has a working 0G Galileo testnet default.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. WALLET  (the ONLY thing that is strictly required to run everything)
#    A 0G Galileo testnet private key, funded from the faucet:
#      https://faucet.0g.ai   (connect X, paste address, ~0.1 0G/day)
#    This single key acts as: contract deployer, agent owner, and the
#    trusted re-encryption signer (override TRUSTED_SIGNER_KEY to separate them).
#    >>> FILL ME <<<  (0x-prefixed, 64 hex chars)
# ----------------------------------------------------------------------------
PRIVATE_KEY=

# Optional: a SECOND funded key to play "the buyer" in transfer demos (Level 3).
# If empty, a random ephemeral buyer is generated where needed.
BUYER_PRIVATE_KEY=

# Optional: dedicated key for the re-encryption oracle signer.
# If empty, PRIVATE_KEY is used as the trusted signer.
TRUSTED_SIGNER_KEY=

# ----------------------------------------------------------------------------
# 2. 0G CHAIN  (defaults are correct for Galileo testnet — leave as-is)
# ----------------------------------------------------------------------------
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602
OG_EXPLORER_URL=https://chainscan-galileo.0g.ai

# ----------------------------------------------------------------------------
# 3. 0G STORAGE  (defaults correct for Galileo testnet — leave as-is)
#    Encrypted personas, trace bundles, fulfillment evidence live here.
# ----------------------------------------------------------------------------
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
OG_STORAGE_EXPLORER=https://storagescan-galileo.0g.ai
OG_FLOW_CONTRACT=0x22E03a6A89B950F1c82ec5e74F8eCa321a105296

# ----------------------------------------------------------------------------
# 4. 0G COMPUTE — Sealed Inference (TEE)   [you chose: BROKER mode]
#
#    BROKER mode (selected): no API key. Your PRIVATE_KEY funds an on-chain
#    ledger and signs each request. 0G Compute runs on the SAME Galileo testnet
#    (chainId 16602), so the same faucet-funded wallet covers it. On first run
#    the runtime opens the ledger with a ONE-TIME 3 0G deposit (0G's minimum).
#    -> the wallet must hold >= ~3.2 0G for broker mode. The faucet gives
#       ~0.1 0G/day, so use the Google Cloud 0G faucet for a larger drip, or
#       switch to router mode (OG_COMPUTE_MODE=router + an sk- API key).
#
#    (To switch to a Router API key later: set OG_COMPUTE_MODE=router and fill
#     OG_COMPUTE_API_KEY with an sk-... key from the 0G compute console.)
# ----------------------------------------------------------------------------
OG_COMPUTE_MODE=broker
OG_COMPUTE_ROUTER_URL=https://router-api.0g.ai/v1
OG_COMPUTE_API_KEY=
OG_COMPUTE_MODEL=zai-org/GLM-5-FP8
# broker runs on the Galileo testnet too — leave as-is:
OG_COMPUTE_RPC_URL=https://evmrpc-testnet.0g.ai
OG_COMPUTE_PROVIDER=
OG_COMPUTE_DEPOSIT=3

# ----------------------------------------------------------------------------
# 5. DEPLOYED CONTRACT ADDRESSES
#    Left blank on purpose. `pnpm deploy:testnet` fills these in
#    automatically (writes deployments/galileo.json). You normally never
#    edit these by hand.
# ----------------------------------------------------------------------------
NEXUS_AGENT_ADDRESS=
PROOFMESH_ADDRESS=
NEXUS_ESCROW_ADDRESS=
REPUTATION_ADDRESS=
COMPOSITE_MINTER_ADDRESS=
